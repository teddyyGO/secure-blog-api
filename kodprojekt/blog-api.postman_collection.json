{
  "info": {
    "name": "Blog API",
    "description": "REST-API for en bloggplattform. Kor requesten uppifran och ner.\n\n1. 'Logga in (anna)' sparar automatiskt token i collection-variabler.\n2. 'Skapa inlagg' sparar postId.\n3. 'Kommentera inlagg' sparar commentId.\n\nI Thunder Client kors inte skripten - kopiera da accessToken ur svaret och klistra in i variabeln 'token' under Env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "commentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 · Auth",
      "item": [
        {
          "name": "Registrera ny anvandare",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "201 Created. additionalProperties: false gor att extra falt slangs bort.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Logga in (anna)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "200 OK. Sparar token, refreshToken och userId som variabler.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"anna@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"token\", d.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", d.refreshToken);",
                  "pm.collectionVariables.set(\"userId\", d.user._id);",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Logga in (bob)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "En ANNAN anvandare. Kor denna och forsok sedan andra annas inlagg -> 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set(\"token\", d.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", d.refreshToken);",
                  "pm.collectionVariables.set(\"userId\", d.user._id);",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Vem ar jag",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "200 OK. Skyddad route - kraver giltig access token."
          },
          "response": []
        },
        {
          "name": "Forny access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/refresh",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "200 OK. Kor den igen direkt och du far 401 - den gamla ar forbrukad.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Logga ut",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/logout",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "204 No Content. Nollar refresh token i databasen."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 · Posts",
      "item": [
        {
          "name": "Lista inlagg",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/posts?page=1&limit=10",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "200 OK. Oppen route. Svaret innehaller bade data och meta."
          },
          "response": []
        },
        {
          "name": "Hamta ett inlagg",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/posts/{{postId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "200 OK, eller 404 om det inte finns."
          },
          "response": []
        },
        {
          "name": "Skapa inlagg",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/posts",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "posts"
              ]
            },
            "description": "201 Created. Sparar postId som variabel.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hej varlden\",\n  \"content\": \"Mitt forsta inlagg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"postId\", pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Uppdatera inlagg",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/posts/{{postId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "200 OK om du ager inlagget, annars 403. PUT kraver bada falten.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Uppdaterad titel\",\n  \"content\": \"Nytt innehall\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Ta bort inlagg",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/posts/{{postId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "204 No Content. Raderar aven inlaggets kommentarer."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3 · Comments",
      "item": [
        {
          "name": "Kommentarer pa ett inlagg",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/posts/{{postId}}/comments",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "posts",
                "{{postId}}",
                "comments"
              ]
            },
            "description": "200 OK. Nastlad resurs - visar relationen mellan posts och comments."
          },
          "response": []
        },
        {
          "name": "Kommentera inlagg",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/posts/{{postId}}/comments",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "posts",
                "{{postId}}",
                "comments"
              ]
            },
            "description": "201 Created. author kommer tillbaka med anvandarnamn tack vare populate().",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Bra inlagg!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"commentId\", pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Hamta en kommentar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/comments/{{commentId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "comments",
                "{{commentId}}"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Uppdatera kommentar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/comments/{{commentId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "comments",
                "{{commentId}}"
              ]
            },
            "description": "200 OK om du ager den, annars 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Andrad kommentar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Ta bort kommentar",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/comments/{{commentId}}",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "comments",
                "{{commentId}}"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "4 · Demonstrera felhantering",
      "item": [
        {
          "name": "Utan token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "401 UNAUTHORIZED - 'jag vet inte vem du ar'."
          },
          "response": []
        },
        {
          "name": "Valideringsfel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "400 VALIDATION_ERROR med details per falt.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"a\",\n  \"email\": \"inte-en-mail\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "NoSQL-injection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "400. Sanitize-hooken tar bort $-nycklarna, sedan sager schemat nej.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": {\n    \"$ne\": null\n  },\n  \"password\": {\n    \"$ne\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Ogiltigt ID-format",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/posts/inte-ett-id",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "posts",
                "inte-ett-id"
              ]
            },
            "description": "400 INVALID_ID. Routen validerar ObjectId-monstret."
          },
          "response": []
        },
        {
          "name": "Okand route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/v1/finnsinte",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "v1",
                "finnsinte"
              ]
            },
            "description": "404 ROUTE_NOT_FOUND fran setNotFoundHandler."
          },
          "response": []
        }
      ]
    }
  ]
}